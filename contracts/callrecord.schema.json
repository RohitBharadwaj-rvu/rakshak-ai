{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CallRecordProposal",
  "description": "PROPOSAL FROM LANE C TO LANE B: Proposed CallRecord schema pending official Lane B review and ownership.",
  "version": "1.1.0",
  "type": "object",
  "required": [
    "call_id",
    "caller_number",
    "verdict",
    "duration"
  ],
  "properties": {
    "call_id": {
      "type": "string",
      "description": "Unique call session ID"
    },
    "caller_number": {
      "type": ["string", "null"],
      "description": "Inbound caller telephone number"
    },
    "verdict": {
      "type": "string",
      "enum": ["scam", "genuine", "unsure"],
      "description": "Classification result"
    },
    "duration": {
      "type": "number",
      "minimum": 0,
      "description": "Call duration in seconds"
    },
    "start_time": {
      "type": ["string", "null"],
      "description": "ISO-8601 UTC timestamp of call initiation (Sprint Plan Interfaces specification)"
    },
    "created_at": {
      "type": ["string", "null"],
      "description": "ISO-8601 UTC timestamp alias for start_time"
    },
    "honeypot_switched_at": {
      "type": ["string", "null"],
      "description": "Timestamp when agent switched to honeypot persona"
    },
    "persona": {
      "type": ["string", "null"],
      "description": "Engaged persona (e.g. ramesh, sunita, iyer)"
    },
    "extracted_intel": {
      "type": "object",
      "properties": {
        "upi_ids": { "type": "array", "items": { "type": "string" } },
        "bank_accounts": { "type": "array", "items": { "type": "string" } },
        "ifsc_codes": { "type": "array", "items": { "type": "string" } },
        "phone_numbers": { "type": "array", "items": { "type": "string" } },
        "links": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": ["string", "null"],
      "description": "Concise summary of call dialogue and intent"
    },
    "message": {
      "type": ["string", "null"],
      "description": "Taken message from genuine caller"
    },
    "report_url": {
      "type": ["string", "null"],
      "description": "URL to generated 1930 incident report dossier"
    },
    "transcript": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "type": "string" },
          "content": { "type": "string" },
          "timestamp": { "type": "number" }
        }
      }
    }
  },
  "additionalProperties": true
}
