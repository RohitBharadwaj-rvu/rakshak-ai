{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CallRecord",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "call_id",
    "caller_number",
    "caller_number_missing",
    "start_time",
    "duration",
    "verdict",
    "honeypot_switch_time",
    "persona",
    "transcript",
    "extracted_intel",
    "summary",
    "report_link",
    "status"
  ],
  "properties": {
    "call_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string"
    },
    "caller_number": {
      "type": "string"
    },
    "caller_number_missing": {
      "type": "boolean",
      "description": "Flagged true when caller number is empty or withheld"
    },
    "start_time": {
      "type": "string",
      "description": "ISO-8601 timestamp of call start or ingestion"
    },
    "duration": {
      "type": "number",
      "minimum": 0
    },
    "verdict": {
      "type": "string",
      "enum": ["scam", "genuine", "unsure"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "honeypot_switch_time": {
      "type": ["string", "null"],
      "description": "ISO-8601 timestamp or offset when switched to honeypot, or null"
    },
    "persona": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "call_recording_url": {
      "type": "string"
    },
    "transcript": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["user", "assistant", "system", "caller"]
          },
          "content": {
            "type": "string"
          },
          "timestamp": {
            "type": "number"
          }
        }
      }
    },
    "extracted_intel": {
      "type": "object",
      "required": [
        "upi_ids",
        "phone_numbers",
        "bank_accounts",
        "ifsc_codes",
        "pan_numbers",
        "links",
        "entity_counts",
        "mid_call_logs"
      ],
      "properties": {
        "upi_ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "phone_numbers": {
          "type": "array",
          "items": {"type": "string"}
        },
        "bank_accounts": {
          "type": "array",
          "items": {"type": "string"}
        },
        "ifsc_codes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "pan_numbers": {
          "type": "array",
          "items": {"type": "string"}
        },
        "links": {
          "type": "array",
          "items": {"type": "string"}
        },
        "entity_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer"}
        },
        "mid_call_logs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "value_as_heard", "normalized_value", "unparseable"],
            "properties": {
              "type": {"type": "string"},
              "value_as_heard": {"type": "string"},
              "normalized_value": {"type": "string"},
              "unparseable": {"type": "boolean"}
            }
          }
        }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "string"
    },
    "report_link": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "finalized", "cleanup_pending"]
    }
  },
  "additionalProperties": true
}
