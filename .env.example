# =======================================================================
# GuardianLine Environment Template (.env.example)
# Copy to .env and fill in your keys:
#   cp .env.example .env
# =======================================================================
# Lane D: Stage 2 Real-Time Classifier
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=your_gemini_api_key_here

# Lane A: Bolna Voice Gateway & Audio Models
BOLNA_API_KEY=your_bolna_api_key_here
BOLNA_AGENT_ID=your_bolna_agent_id_here
SARVAM_API_KEY=your_sarvam_api_key_here

# Lane B: Backend & Webhooks
BOLNA_WEBHOOK_SECRET=local_dev_secret_123
GUARDIANLINE_API_TOKEN=local_api_token_123
GUARDIANLINE_DB_PATH=guardianline_calls.db
MISTRAL_API_KEY=your_mistral_api_key_here

# Lane C: Family Alerts & Protection (see docs/lane_c_integration.md)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_FROM=+14155238886
ALERT_CHANNEL=whatsapp
# Required: comma-separated family numbers in E.164 (alerts are disabled when empty)
FAMILY_ALERT_TO=
ALERT_DB_PATH=data/alerts.db
REPORT_BASE_URL=http://localhost:8000/dashboard/report
# Long random values, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
GUARDIAN_DASHBOARD_TOKEN=
REPORT_SIGNING_SECRET=
GUARDIAN_EVENTS_TOKEN=
